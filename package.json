{
  "name": "brandspec",
  "version": "0.1.0",
  "description": "Define Brand Identity as code. CLI for creating, validating, and generating brand tokens.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brandspec": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schema",
    "workshop"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/index.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "brandspec",
    "brand",
    "identity",
    "design-tokens",
    "yaml",
    "workshop",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://brandspec.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandspec/brandspec"
  }
}
